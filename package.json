{
  "name": "digital-quiz-portal",
  "version": "1.0.0",
  "description": "Digital Quiz Portal (Online Exam & Assessment Portal) - STQA & OOMD Mini-Project",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/database/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:browser": "node tests/browser/browser_automation.js"
  },
  "keywords": [
    "quiz-portal",
    "online-exam",
    "stqa",
    "oomd",
    "sql.js",
    "express"
  ],
  "author": "Ashlesha Gosavi, Divya Lokhande, Bhakti Pate",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
